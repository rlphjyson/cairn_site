# Build-time configuration. Pass with:
#   jaspr build --dart-define-from-file=.env
#
# EVERYTHING in this file is compiled into the binary and, for client-visible
# values, into the browser bundle. It is public. Never put secrets here.
APP_ENV=production
SITE_URL=https://shop.example
CURRENCY=USD
ANALYTICS=false

# Runtime configuration (NOT compiled in; set in the process environment):
#   PORT=8080
#   SITE_URL=https://shop.example      overrides the compiled value
#   CART_SECRET=<32+ random characters> signs the cart cookie
